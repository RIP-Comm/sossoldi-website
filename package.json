{
  "name": "sossoldi-website",
  "version": "1.0.0",
  "private": true,
  "description": "Public website for Sossoldi — install, docs, changelog and blog. Eleventy, bilingual EN/IT, Pagefind search.",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/sync-tokens.mjs",
    "dev": "node scripts/sync-tokens.mjs && eleventy --serve",
    "build": "node scripts/sync-tokens.mjs && node scripts/check-translations.mjs && rm -rf _site && eleventy && pagefind --site _site",
    "build:fast": "node scripts/sync-tokens.mjs && eleventy",
    "assets": "python3 scripts/optimize-assets.py && python3 scripts/make-og.py",
    "check": "node scripts/check-translations.mjs && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "translations:stamp": "node scripts/check-translations.mjs --write",
    "og": "python3 scripts/make-og.py",
    "snapshot": "node scripts/snapshot-github.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-plugin-rss": "3.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pagefind": "1.6.0"
  }
}
