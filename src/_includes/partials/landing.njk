{% set t = ui[lang] %}
<section class="hero">
  <div class="wrap hero-inner">
    <span class="badge"><span class="dot" aria-hidden="true"></span>{{ releases.latest.name }} · open source · MIT</span>
    <h1>{{ t.home.title }}</h1>
    <p class="lead">{{ t.home.lead }}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="{{ site.stores.ios }}" rel="noopener">{{ t.home.ctaDownload }}</a>
      <a class="btn btn-link" href="{{ '/docs/' if lang == 'en' else '/it/docs/' }}">{{ t.home.ctaPrimary }} →</a>
    </div>
    <div class="stores">
      <a class="store-badge" href="{{ site.stores.ios }}" rel="noopener">
        <img src="/assets/img/app-store-badge.svg" alt="Download on the App Store" width="120" height="34" loading="lazy">
      </a>
      <a class="store-badge" href="{{ site.stores.android }}" rel="noopener">
        <img src="/assets/img/google-play-badge.png" alt="Get it on Google Play" width="124" height="34" loading="lazy">
      </a>
      <a class="store-badge" href="{{ site.stores.fDroid }}" rel="noopener">
        <img src="/assets/img/fdroid-badge.png" alt="Get it on F-Droid" width="124" height="34" loading="lazy">
      </a>
    </div>
  </div>

  <div class="stage" aria-hidden="true">
    <div class="glow"></div>
    <div class="phone p-left"><img src="/assets/img/screens/04.webp" alt="" width="1206" height="2622" loading="lazy"></div>
    <div class="phone p-mid"><img src="/assets/img/screens/01.webp" alt="Sossoldi dashboard on an iPhone" width="1206" height="2622" fetchpriority="high"></div>
    <div class="phone p-right"><img src="/assets/img/screens/03.webp" alt="" width="1206" height="2622" loading="lazy"></div>
    <div class="float-card c1">
      <span class="label">{{ t.home.stageCard1Label }}</span>
      <strong>{{ t.home.stageCard1Value }}</strong>
    </div>
    <div class="float-card c2">
      <span class="label">{{ t.home.stageCard2Label }}</span>
      <strong>{{ t.home.stageCard2Value }}</strong>
      <span class="note">{{ t.home.stageCard2Note }}</span>
      <span class="bar"><span></span></span>
    </div>
  </div>
</section>

<section class="features">
  <div class="wrap">
    <div class="features-head">
      <h2>{{ t.home.featuresTitle }}</h2>
      <p class="lead">{{ t.home.featuresLead }}</p>
    </div>
    <div class="features-grid">
      <article class="feature">
        <h3>{{ t.home.features[0].title }}</h3>
        <p>{{ t.home.features[0].body }}</p>
        <div class="mini">
          <span class="label">{{ t.home.stageCard1Label }}</span>
          <strong>{{ t.home.stageCard1Value }}</strong>
        </div>
      </article>
      <article class="feature">
        <h3>{{ t.home.features[3].title }}</h3>
        <p>{{ t.home.features[3].body }}</p>
        <div class="mini">
          <span class="label">{{ t.home.stageCard2Label }}</span>
          <strong>{{ t.home.stageCard2Value }}</strong>
          <span class="note">{{ t.home.stageCard2Note }}</span>
          <span class="bar"><span></span></span>
        </div>
      </article>
      <article class="feature">
        <h3>{{ t.home.features[4].title }}</h3>
        <p>{{ t.home.features[4].body }}</p>
        <div class="mini">
          <div class="row"><span>Books</span><span>−€10.99</span></div>
          <div class="pillrow"><span class="pill">{{ t.home.miniMonthly }}</span><span class="pill">{{ t.home.miniNext }}</span></div>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap band-grid">
    <div>
      <p class="eyebrow">{{ t.nav.github }}</p>
      <h2>{{ t.home.openTitle }}</h2>
      <p class="lead">{{ t.home.openLead }}</p>
      <p style="margin-top:24px"><a class="btn" href="{{ site.repo }}" rel="noopener">{{ t.home.openCta }} ↗</a></p>
    </div>
    <div class="stats">
      <div class="stat"><strong>{{ github.stars | number(lang) }}</strong><span>{{ t.home.proofStars }}</span></div>
      <div class="stat"><strong>{{ github.contributors | number(lang) }}</strong><span>{{ t.home.proofContributors }}</span></div>
      <div class="stat"><strong>MIT</strong><span>{{ t.home.proofLicense }}</span></div>
    </div>
  </div>
</section>
